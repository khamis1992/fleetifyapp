# Copy this file to .env.taqadi-agent on the Windows computer that will run
# the Taqadi browser worker. Never commit real service-role keys or tokens.

TAQADI_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
TAQADI_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

SUPABASE_PROJECT_REF=qwhunliohlkkahbspfiu
# Optional. Required only when applying production database guards through
# `npm run customers:apply-arabic-data-guard`. Use a Supabase Management API
# access token with database_write permission.
SUPABASE_ACCESS_TOKEN=

TAQADI_WORKER_ID=legal-office-1
TAQADI_PORTAL_URL=https://taqadi.sjc.gov.qa/itc/login
TAQADI_HEADLESS=false
TAQADI_FINAL_APPROVAL=true
TAQADI_STOP_AFTER_PARTIES=false
TAQADI_HEALTH_PORT=4317
TAQADI_POLL_INTERVAL_MS=5000
TAQADI_LOGIN_TIMEOUT_MS=600000
TAQADI_ACTION_TIMEOUT_MS=30000
# Keep full Playwright DOM snapshots off during normal operation. Enable only
# while diagnosing a portal regression because Taqadi pages produce large traces.
TAQADI_TRACE_SNAPSHOTS=false

# On Windows, use `npm run taqadi:agent:credentials` instead of storing the
# Tawtheeq password in this file. These variables are only a fallback for
# non-Windows/manual worker environments.
TAQADI_TAWTHEEQ_USERNAME=
TAQADI_TAWTHEEQ_PASSWORD=

TAQADI_REPRESENTATIVE_NAME=خميس الجبر
TAQADI_REPRESENTATIVE_PHONE=
TAQADI_REPRESENTATIVE_EMAIL=
TAQADI_REPRESENTATIVE_ADDRESS=الدوحة قطر
TAQADI_REPRESENTATIVE_NATIONALITY=قطر
TAQADI_REPRESENTATIVE_ID_TYPE=بطاقة شخصية
TAQADI_REPRESENTATIVE_ID_NUMBER=

TAQADI_REPRESENTATIVE_PRINCIPAL_NAME=شركة العراف لتأجير السيارات
TAQADI_REPRESENTATIVE_GUARDIAN_TYPE=طبيعي
TAQADI_REPRESENTATIVE_CONNECTION_DEGREE=أخرى

TAQADI_COMPANY_ESTABLISHMENT_NUMBER=17201586
TAQADI_COMPANY_ESTABLISHMENT_ISSUER=وزارة التجارة والصناعة

